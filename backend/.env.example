# ---------------------------------------------------------------------------
# Copy to backend/.env and fill in as needed. NEVER commit real keys.
# All variables are optional: the API starts without any of them and reports
# which AI capabilities are unconfigured via GET /api/health.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=SIH PS-108 Standards Recommendation API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Comma separated list of allowed CORS origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Filesystem ------------------------------------------------------------
# Absolute or relative path to the data directory (raw/processed/vector_store).
DATA_DIR=../data
MAX_UPLOAD_SIZE_MB=25

# --- LLM provider (choose later; empty means "not configured") -------------
LLM_PROVIDER=unconfigured
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- Embedding provider ----------------------------------------------------
# Built-in keys for EMBEDDING_PROVIDER:
#   unconfigured      - default; nothing is embedded, the API explains itself
#   onnx_minilm       - all-MiniLM-L6-v2 (384 dims) run LOCALLY through chromadb:
#                       no API key, no network after the one-off weight download
#                       into ~/.cache/chroma/onnx_models. Needs requirements-rag.txt
#   openai_compatible - any OpenAI-style POST /embeddings endpoint (OpenAI, the
#                       Gemini compatibility mode, Jina, vLLM, ...): needs
#                       EMBEDDING_MODEL + EMBEDDING_API_KEY, EMBEDDING_BASE_URL
#                       only for non-OpenAI hosts
# After changing provider or model, rebuild the index:
#   python -m app.rag.index_standards --reset
EMBEDDING_PROVIDER=unconfigured
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# Leave commented out unless the endpoint needs it: an empty value is invalid for
# an integer setting, and the local provider knows its own length (384).
# EMBEDDING_DIMENSION=

# --- Vector store ----------------------------------------------------------
VECTOR_STORE_PROVIDER=chroma
VECTOR_COLLECTION_NAME=indian_standards
VECTOR_DB_PATH=../data/vector_store

# --- Chunking / retrieval --------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=10

# --- SQL database (PostgreSQL-ready, not required yet) ---------------------
DATABASE_URL=

# --- Standards dataset (verified Indian Standards catalogue) ----------------
# Relative paths are resolved against backend/ first, then the project root.
# Two catalogues ship with the repo and both validate against the same schema:
#   data/standards/standards_enriched_bis_verified.json - 20 records, every
#       record carries a BIS-verified title, scope and publication status
#   data/standards/standards.json                      - the earlier subset,
#       where some fields are still unverified (null) on purpose
# Neither is the complete BIS catalogue. Leave empty to run without a catalogue
# (the API stays honest and reports "dataset_unavailable").
STANDARDS_DATASET_PATH=../data/standards/standards_enriched_bis_verified.json
